# Copy to backend/.env and fill in ONE provider block. Never commit the real .env.
#
# NimbusSupport runs on whichever provider you have a key for. Either set the two
# universal variables below, or just paste a vendor key (e.g. GROQ_API_KEY) and the
# backend auto-detects the provider.

# ---- Universal switch (recommended) ----
# LLM_PROVIDER: azure | openai | anthropic | gemini | openrouter | groq | cerebras | ollama
LLM_PROVIDER=azure
LLM_API_KEY=your-api-key
# LLM_MODEL=            # optional — each provider has a sensible default
# LLM_BASE_URL=         # optional — override for proxies / self-hosted gateways


# =============================================================================
# 1) Microsoft Foundry / Azure OpenAI      https://ai.azure.com/
# =============================================================================
# LLM_PROVIDER=azure
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21
# Note: MODEL names here are your *deployment* names, not the base model names.

# =============================================================================
# 2) OpenAI                                https://platform.openai.com/api-keys
# =============================================================================
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# 3) Anthropic                             https://console.anthropic.com/settings/keys
# =============================================================================
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
# Anthropic has no embeddings API, so EMBEDDING_PROVIDER defaults to `local`
# (a MiniLM ONNX model bundled with ChromaDB — no key, no network).

# =============================================================================
# 4) Google Gemini                         https://aistudio.google.com/apikey
# =============================================================================
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# =============================================================================
# 5) OpenRouter                            https://openrouter.ai/keys
# =============================================================================
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Chat only — embeddings fall back to `local`.

# =============================================================================
# 6) Groq                                  https://console.groq.com/keys
# =============================================================================
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# Chat only — embeddings fall back to `local`.

# =============================================================================
# 7) Cerebras                              https://cloud.cerebras.ai/
# =============================================================================
# LLM_PROVIDER=cerebras
# CEREBRAS_API_KEY=csk-...
# CEREBRAS_MODEL=llama-3.3-70b
# Chat only — embeddings fall back to `local`.

# =============================================================================
# 8) Ollama (local, no key)                https://ollama.com/download
# =============================================================================
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Pull both first:  ollama pull llama3.1 && ollama pull nomic-embed-text
# Use a tool-capable model — the agent relies on function calling.


# ---- Embeddings (optional override) ----
# By default embeddings use the same provider as chat, falling back to `local`
# when that provider has no embeddings API.
# EMBEDDING_PROVIDER=local        # azure | openai | gemini | ollama | local
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=
# Re-run `uv run python -m app.rag.ingest` after changing the embedding model —
# each model gets its own ChromaDB collection.

# ---- API ----
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# ---- Observability (Langfuse Cloud via OpenTelemetry) ----
OBSERVABILITY_ENABLED=true
LANGFUSE_PUBLIC_KEY=your-LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=your-LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://us.cloud.langfuse.com
OTEL_SERVICE_NAME=nimbussupport-backend
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS=true
SEMANTICKERNEL_EXPERIMENTAL_GENAI_ENABLE_OTEL_DIAGNOSTICS_SENSITIVE=true
